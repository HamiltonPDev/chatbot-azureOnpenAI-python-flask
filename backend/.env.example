# Copy to .env and fill in the two secret values.
# .env is gitignored; this file is not.

AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_KEY=

# Deployment name as it appears in the Azure portal. Note this is a label,
# not a model identity - the response reports which model actually answered.
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-02-01

# CORS allowlist. Vite's dev server default.
FRONTEND_ORIGIN=http://localhost:5173
